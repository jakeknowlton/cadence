{
  "name": "cadence",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:staging": "run-p type-check \"build-only --mode staging\"",
    "deploy:dev": "pnpm build:staging && firebase deploy --project dev",
    "deploy:prod": "pnpm build && firebase deploy --project prod",
    "dev": "vite",
    "dev:all": "run-p emulators dev",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-cadence --import=./emulator-data --export-on-exit",
    "format": "oxfmt src/",
    "icons": "node scripts/render-icons.mjs",
    "lint": "run-s \"lint:*\"",
    "lint:eslint": "eslint . --fix --cache",
    "lint:oxlint": "oxlint . --fix",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-cadence \"playwright test --project=chromium\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cadence \"vitest run --config vitest.rules.config.ts\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1",
    "vuefire": "^3.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "firebase-tools": "^15.33.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
