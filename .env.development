# Local development against the Firebase Emulator Suite. No real project needed.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cadence.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cadence
VITE_FIREBASE_APP_ID=demo-app-id
