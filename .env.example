# Copy to .env.production (or .env.staging) with values from the Firebase console:
# Project settings > General > Your apps > SDK setup and configuration. These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_USE_EMULATORS=false
